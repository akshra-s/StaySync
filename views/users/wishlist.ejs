<% layout("/layouts/boilerplate") -%>
<div class="container mt-5">
    <h2>My Wishlist</h2>
    <hr>
    <% if (currUser.wishlist.length === 0) { %>
        <p>Your wishlist is empty.</p>
    <% } else { %>
        <% currUser.wishlist.forEach(list => { %>
            <div class="mb-3">
                <a href="/listing/<%= list._id %>">
                    <%= list.title %>
                </a>
            </div>
        <% }) %>
    <% } %>
</div>