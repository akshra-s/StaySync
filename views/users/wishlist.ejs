<% layout("/layouts/boilerplate") -%>

<div class="container mt-5">

    <h2>My Wishlist</h2>

    <hr>

    <% if (currUser.wishlist.length === 0) { %>

        <div class="text-center py-5">
            <h4>Your wishlist is empty</h4>
            <p class="text-muted">
                Save your favorite stays and find them here later.
            </p>

            <a href="/listing" class="btn btn-dark">
                Explore Listings
            </a>
        </div>

    <% } else { %>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">

            <% currUser.wishlist.forEach(list => { %>

                <div class="col">

                    <div class="card h-100">

                        <img
                            src="<%= list.image %>"
                            class="card-img-top"
                            alt="<%= list.title %>"
                            style="height: 220px; object-fit: cover;"
                        >

                        <div class="card-body">

                            <h5 class="card-title">
                                <%= list.title %>
                            </h5>

                            <p class="text-muted">
                                <%= list.location %>, <%= list.country %>
                            </p>

                            <p>
                                ₹<%= list.price.toLocaleString("en-IN") %> / night
                            </p>

                            <a
                                href="/listing/<%= list._id %>"
                                class="btn btn-outline-dark"
                            >
                                View Listing
                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>