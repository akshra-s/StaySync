<% layout("/layouts/boilerplate") -%>
    <div id="filters">
        <a href="/listing/trending" class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>

        <a href="/listing?category=Rooms" class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>

        <a href="/listing?category=Iconic Cities" class="filter">
            <div><i class="fa-solid fa-city"></i></div>
            <p>Iconic Cities</p>
        </a>

        <a href="/listing?category=Beach" class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
        </a>

        <a href="/listing?category=Lakefront" class="filter">
            <div><i class="fa-solid fa-water"></i></div>
            <p>Lakefront</p>
        </a>

        <a href="/listing?category=Mountains" class="filter">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>Mountains</p>
        </a>

        <a href="/listing?category=Farms" class="filter">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farms</p>
        </a>

        <a href="/listing?category=Camping" class="filter">
            <div><i class="fa-solid fa-person-hiking"></i></div>
            <p>Camping</p>
        </a>

        <a href="/listing?category=Pools" class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Pools</p>
        </a>

        <a href="/listing?category=Arctic" class="filter">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </a>
        <div class="tax-switch">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                </div>
        </div>
    </div>
        
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for (let list of allList){ %>
            <a href="/listing/<%=list._id%>" class="list-link">
                <div class="card col listing-card">
                    <img src="<%=list.image.url%>" class="card-img-top" alt="listing_img">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= list.title %></b>
                            <br>
                            &#8377; <%= list.price.toLocaleString('en-IN')%> / night
                            <i class="taxInfo">&nbsp;+&nbsp;18%GST</i>
                        </p>
                    </div>
                </div>
            </a>
            
    <% } %>
    </div>



