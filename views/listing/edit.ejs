<% layout("/layouts/boilerplate") -%>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
            <h3>Edit Listing :</h3>
            <br>
            <form method="POST" action="/listing/<%= list._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-4">
                    <label for="title" class="form-label"><b>Title</b></label>
                    <input
                        id="title"
                        type="text"
                        name="listing[title]"
                        value="<%= list.title %>"
                        class="form-control"
                        required>
                    <div class="invalid-feedback">Invalid Title !</div>    
                        
                </div>
                <div class="mb-4">
                    <label for="description" class="form-label"><b>Description</b></label>
                    <textarea
                        name="listing[description]"
                        class="form-control"
                        rows="4"
                        required><%= list.description %></textarea>
                    <div class="invalid-feedback">Invalid Description !</div>    
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label"><b>Listing Image</b></label><br/>
                    <img src="<%= orgImage%>"/>
                </div>

                <div class="mb-4">
                    <label for="img" class="form-label"><b>Upload New Image</b></label>
                    <input
                        type="file"
                        name="listing[image]"
                        value="<%= list.image %>"
                        class="form-control">
                    <div class="invalid-feedback">Invalid Image !</div>    
                </div>
                <div class="row">
                    <div class="mb-4 col-4">
                        <label for="price" class="form-label"><b>Price</b></label>
                        <input
                            type="number"
                            name="listing[price]"
                            value="<%= list.price %>"
                            class="form-control"
                            min="0"
                            required>
                        <div class="invalid-feedback">Invalid Price !</div>    
                    </div>
                    <div class="mb-4 col-8">
                        <label for="location" class="form-label"><b>Location</b></label>
                        <input
                            type="text"
                            name="listing[location]"
                            value="<%= list.location %>"
                            class="form-control"
                            required>
                        <div class="invalid-feedback">Invalid Location !</div>    
                    </div>
                </div>
                <div class="mb-4">
                    <label for="country" class="form-label"><b>Country</b></label>
                    <input
                        type="text"
                        name="listing[country]"
                        value="<%= list.country %>"
                        class="form-control"
                        required>
                    <div class="invalid-feedback">Invalid Country !</div>    
                </div>
                <div class="mb-4">
                    <label for="category" class="form-label"><b>Category</b></label>
                    <select name="listing[category]" id="category" class="form-select" required>
                        <option value="Trending" <%= list.category === "Trending" ? "selected" : "" %>>Trending</option>
                        <option value="Rooms" <%= list.category === "Rooms" ? "selected" : "" %>>Rooms</option>
                        <option value="Iconic Cities" <%= list.category === "Iconic Cities" ? "selected" : "" %>>Iconic Cities</option>
                        <option value="Beach" <%= list.category === "Beach" ? "selected" : "" %>>Beach</option>
                        <option value="Lakefront" <%= list.category === "Lakefront" ? "selected" : "" %>>Lakefront</option>
                        <option value="Mountains" <%= list.category === "Mountains" ? "selected" : "" %>>Mountains</option>
                        <option value="Farms" <%= list.category === "Farms" ? "selected" : "" %>>Farms</option>
                        <option value="Camping" <%= list.category === "Camping" ? "selected" : "" %>>Camping</option>
                        <option value="Pools" <%= list.category === "Pools" ? "selected" : "" %>>Pools</option>
                        <option value="Arctic" <%= list.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                    </select>
                </div>
                <br>
                <button class="btn btn-dark edit-btn">Save Changes</button>
                <br><br>
            </form>
        </div>
    </div>

