<% layout("/layouts/boilerplate") -%>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
            <h3>Create New List :</h3>
            <br>
            <form method="POST" action="/listing" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-4">
                    <label for="title" class="form-label">Title</label>
                    <input id="title" name="listing[title]" placeholder="Enter Title" type="text" class="form-control" required>
                    <div class="invalid-feedback">Invalid Title !</div>
                </div>
                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]"class="form-control"rows="4" required></textarea>
                    <div class="invalid-feedback">Invalid Description !</div>
                </div>

                <div class="mb-4">
                    <label for="img" class="form-label">Upload Image</label>
                    <input name="listing[image]" type="file"class="form-control">
                </div>


                <div class="row">
                    <div class="mb-4 col-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" placeholder="Enter price" class="form-control" min="0" required>
                    <div class="invalid-feedback">Invalid Price !</div>
                    </div>

                    <div class="mb-4 col-8">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" placeholder="Enter location"type="text"class="form-control" required>
                    <div class="invalid-feedback">Invalid Location !</div>
                    </div>
                </div>
                <div class="mb-4">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" placeholder="Enter country"type="text"class="form-control" required>
                    <div class="invalid-feedback">Invalid Country !</div>
                </div>
                <div class="mb-4">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" id="category" class="form-select" required>
                        <option value="" selected disabled>Choose a category</option>
                        <option value="Trending">Trending</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Beach">Beach</option>
                        <option value="Lakefront">Lakefront</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Farms">Farms</option>
                        <option value="Camping">Camping</option>
                        <option value="Pools">Pools</option>
                        <option value="Arctic">Arctic</option>
                    </select>
                    <div class="invalid-feedback">Please select a category.</div>
                </div>
                <br>
                <button class="btn btn-dark add-btn">Add</button>
                <br><br>
            </form>
        </div>
    </div>
